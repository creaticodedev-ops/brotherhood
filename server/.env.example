# Copy to server/.env (never commit real credentials)

# Local MongoDB — also usable from MongoDB Compass
MONGODB_URI=mongodb://127.0.0.1:27017/udbonds

# API server (the front-end dev server proxies /api to it)
PORT=5000

# Admin dashboard (/admin) — initial password only (12 characters minimum).
# On first start it is hashed (scrypt) into the database; remove it from this file afterwards.
# Later changes go through "Forgot password" on the admin login page.
ADMIN_PASSWORD=
# Optional: secret used to sign admin sessions (defaults to a random secret stored with the account)
ADMIN_SESSION_SECRET=

# Admin password reset — public address of the site, used to build the reset link
ADMIN_APP_URL=http://localhost:3000
# Optional: e-mail delivery of the reset link. Without SMTP, the link is printed in the API server terminal.
ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
